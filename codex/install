#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
source_dir=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
package="$HOME/.local/libexec/sessionbus/codex"
marketplace="$HOME/.local/share/sessionbus/codex/marketplace"
marketplace_parent=$(dirname "$marketplace")
mkdir -p "$package/bin" "$HOME/.local/bin" "$marketplace_parent"
marketplace_stage=$(mktemp -d "$marketplace_parent/.marketplace.XXXXXX")
trap 'rm -rf "$marketplace_stage"' EXIT HUP INT TERM
cp -R "$source_dir/marketplace/." "$marketplace_stage/"
install -m 755 "$source_dir/bin/codex-peer" "$package/bin/codex-peer.new"
mv -f "$package/bin/codex-peer.new" "$package/bin/codex-peer"
for alias in codex-peer-mcp codex-peer-broker codex-peer-install; do
 ln -sfn codex-peer "$package/bin/$alias"
done
ln -sfn "$package/bin/codex-peer" "$HOME/.local/bin/codex-peer"
rm -rf "$marketplace"
mv "$marketplace_stage" "$marketplace"
cp "$source_dir/README.md" "$source_dir/LICENSE" "$source_dir/THIRD-PARTY-NOTICES.txt" "$source_dir/uninstall" "$package/"
"$package/bin/codex-peer-install" "$marketplace"
printf 'Installed %s\n' "$HOME/.local/bin/codex-peer"
