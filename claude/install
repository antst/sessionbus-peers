#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
command -v claude >/dev/null || { echo 'Install and sign in to native Claude first.' >&2; exit 1; }
src=$(CDPATH='' cd "$(dirname "$0")" && pwd -P)
root="$HOME/.local/libexec/sessionbus/claude"
[ ! -L "$root" ] || { echo 'Indirect Claude package root; review before replacing.' >&2; exit 1; }
mkdir -p "$root" "$HOME/.local/bin"
stage=$(mktemp -d "$root/.plugin.XXXXXX")
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
cp -R "$src/plugin/." "$stage/"
# Replace the executable inode so an existing native session is not truncated.
install -m 755 "$src/claude-peer" "$root/claude-peer.new"
mv -f "$root/claude-peer.new" "$root/claude-peer"
rm -rf "$root/plugin"
mv "$stage" "$root/plugin"
cp "$src/LICENSE" "$src/README.md" "$root/"
ln -sfn "$root/claude-peer" "$HOME/.local/bin/claude-peer"
"$HOME/.local/bin/claude-peer" --version
printf 'Installed %s. Ordinary claude remains ordinary.\n' "$HOME/.local/bin/claude-peer"
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) printf 'Add to your login profile: export PATH="$HOME/.local/bin:$PATH"\n';; esac
