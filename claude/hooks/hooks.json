{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:sessionbus:sessionbus",
            "tool": "native_identity_event",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "session_title": "${session_title}",
              "reason": "${reason}",
              "agent_id": "${agent_id}"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:sessionbus:sessionbus",
            "tool": "native_identity_event",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "session_title": "${session_title}",
              "reason": "${reason}",
              "agent_id": "${agent_id}"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:sessionbus:sessionbus",
            "tool": "native_identity_event",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "session_title": "${session_title}",
              "reason": "${reason}",
              "agent_id": "${agent_id}"
            }
          }
        ]
      }
    ]
  }
}
