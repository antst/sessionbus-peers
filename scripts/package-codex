#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
output=${1:?usage: scripts/package-codex OUTPUT_DIRECTORY}
mkdir -p "$output"
output=$(cd "$output" && pwd -P)
repo=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT HUP INT TERM
cd "$repo"
. "$repo/scripts/release/version.sh"
peer_version_init "$repo"
goos=${GOOS:-$(go env GOOS)}
goarch=${GOARCH:-$(go env GOARCH)}
mkdir -p "$stage/bin"
GOOS="$goos" GOARCH="$goarch" CGO_ENABLED=0 peer_go_build "$stage/bin/codex-peer" ./cmd/codex-peer
for alias in codex-peer-mcp codex-peer-broker codex-peer-install; do
 ln -s codex-peer "$stage/bin/$alias"
done
cp -R codex/marketplace "$stage/"
manifest="$stage/marketplace/codex/.codex-plugin/plugin.json"
codex_source_version="$peer_base_version-codex.0"
codex_revision=$(printf '%.12s' "$peer_revision")
codex_staged_version="$peer_base_version-codex.g$codex_revision"
test "$(grep -Fc "\"version\": \"$codex_source_version\"" "$manifest")" -eq 1
sed "s/$codex_source_version/$codex_staged_version/" "$manifest" > "$manifest.new"
mv "$manifest.new" "$manifest"
cp codex/THIRD-PARTY-NOTICES.txt LICENSE codex/README.md codex/install codex/uninstall "$stage/"
printf '%s\n' "$peer_revision" > "$stage/SOURCE.txt"
printf 'codex\n' > "$stage/ROLE"
archive="$output/codex-peer-$goos-$goarch.tar.gz"
tar -czf "$archive" -C "$stage" bin marketplace LICENSE THIRD-PARTY-NOTICES.txt README.md install uninstall ROLE SOURCE.txt
printf '%s\n' "$archive"
