#!/usr/bin/env bash
# SPDX-License-Identifier: MIT

install_codex_mcp() {
  local codex_path=$1 peer_path=$2 groups=${3:-[]}
  local mcp_env=(--env "SESSIONBUS_GROUPS=$groups")
  [[ "$peer_path" == /* && -x "$peer_path" ]] || return 2
  "$codex_path" mcp remove sessionbus >/dev/null 2>&1 || return
  if [[ -n ${SESSIONBUS_LOCAL_KEY:-} ]]; then
    mcp_env=(--env "SESSIONBUS_LOCAL_KEY=$SESSIONBUS_LOCAL_KEY" "${mcp_env[@]}")
  fi
  if [[ -n ${SESSIONBUS_SOCKET:-} ]]; then
    mcp_env=(--env "SESSIONBUS_SOCKET=$SESSIONBUS_SOCKET" "${mcp_env[@]}")
  fi
  if [[ -n ${CODEX_HOME:-} ]]; then
    mcp_env+=(--env "CODEX_HOME=$CODEX_HOME")
  fi
  "$codex_path" mcp add "${mcp_env[@]}" sessionbus -- "$peer_path" mcp || return
  "$codex_path" app-server daemon restart
}

remove_codex_mcp() {
  local codex_path=$1
  "$codex_path" mcp remove sessionbus >/dev/null 2>&1 || return
  "$codex_path" app-server daemon restart
}
