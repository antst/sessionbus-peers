#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
product=${1:?usage: scripts/test-native-plugin PRODUCT}
repo=$(CDPATH='' cd "$(dirname "$0")/.." && pwd -P)
stage=$(CDPATH='' cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$stage"' 0
trap 'exit 1' HUP INT TERM
cd "$repo"
go run ./internal/cmd/stage-native-plugin -repo "$repo" -product "$product" -output "$stage/plugin" -tests
# Resolve the exact already-installed development kit through the staged package.
# No dependency is installed by this runner and no target runtime is added.
if [ ! -d "$repo/$product/node_modules/@sessionbus/kit" ]; then
 echo "Run npm ci --ignore-scripts in $product before its development tests." >&2
 exit 1
fi
ln -s "$repo/$product/node_modules" "$stage/plugin/node_modules"
cd "$stage/plugin"
node --test ./*.test.mjs
