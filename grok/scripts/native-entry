#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
set -euo pipefail

# Grok starts this stdio MCP entry in both peer and lane mode.
peer_binary="${HOME}/.local/libexec/sessionbus/grok/grok-peer-mcp"
if [[ ! -x "$peer_binary" ]]; then
  printf 'sessionbus: grok-peer is not installed\n' >&2
  exit 1
fi
exec "$peer_binary"
